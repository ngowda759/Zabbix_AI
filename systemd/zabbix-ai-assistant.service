[Unit]
Description=Zabbix AI Assistant API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zbxai
Group=zbxai
WorkingDirectory=/opt/zabbix-ai-assistant/backend
EnvironmentFile=/etc/zabbix-ai-assistant/assistant.env
ExecStart=/opt/zabbix-ai-assistant/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
